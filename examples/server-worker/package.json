{
  "name": "@kujam/example-server-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Contoh worker server: membaca state Yjs papan, memvalidasi, mengekstrak referensi dengan diff, dan membuat thumbnail lewat @kujam/server (BOARD-1805)",
