{
  "name": "@kujam/renderer",
  "version": "0.1.0",
  "description": "Renderer Canvas 2D, lapisan HTML untuk elemen kustom, dan overlay interaktif untuk @kujam/core",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kustora/kujam.git",
    "directory": "packages/renderer"
  },
  "homepage": "https://github.com/kustora/kujam/tree/main/packages/renderer#readme",
  "bugs": {
    "url": "https://github.com/kustora/kujam/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kujam/core": "workspace:*",
    "perfect-freehand": "^1.2.2"
  },
  "devDependencies": {
    "happy-dom": "^21.0.3"
  }
}
