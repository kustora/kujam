{
  "name": "@kujam/shapes",
  "version": "0.1.0",
  "description": "Elemen dan tool bawaan untuk @kujam/core (sticky, coretan, teks, geometri, konektor, frame, gambar, grup)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kujam/core": "workspace:*",
    "perfect-freehand": "^1.2.2"
  }
}

