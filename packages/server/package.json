{
  "name": "@kujam/server",
  "version": "0.1.0",
  "description": "Utilitas Node.js untuk @kujam/core (validasi dokumen, migrasi, ekstraksi referensi, dan render thumbnail)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kujam/core": "workspace:*"
  }
}
