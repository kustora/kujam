{
  "name": "@kujam/server",
  "version": "0.2.0",
  "description": "Utilitas Node.js untuk @kujam/core (validasi dokumen, migrasi, ekstraksi referensi, dan render thumbnail)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kustora/kujam.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/kustora/kujam/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/kustora/kujam/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --root ../.. packages/server/src",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kujam/core": "workspace:*",
    "@kujam/renderer": "workspace:*",
    "@kujam/sync-yjs": "workspace:*"
  }
}
