{
  "name": "@kujam/core",
  "version": "0.2.0",
  "description": "Inti whiteboard agnostik tanpa DOM dan tanpa dependensi runtime",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kustora/kujam.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/kustora/kujam/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/kustora/kujam/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --root ../.. --project core",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {},
  "devDependencies": {
    "fractional-indexing": "^3.2.0",
    "nanoid": "^5.1.0",
    "rbush": "^4.0.1",
    "@types/rbush": "^4.0.0"
  }
}
