{
  "name": "@kujam/export",
  "version": "0.2.0",
  "description": "Ekspor PNG, SVG, PDF, teks polos, dan JSON untuk @kujam/core",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kustora/kujam.git",
    "directory": "packages/export"
  },
  "homepage": "https://github.com/kustora/kujam/tree/main/packages/export#readme",
  "bugs": {
    "url": "https://github.com/kustora/kujam/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kujam/core": "workspace:*",
    "@kujam/renderer": "workspace:*",
    "pdf-lib": "^1.17.1"
  }
}
