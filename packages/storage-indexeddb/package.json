{
  "name": "@kujam/storage-indexeddb",
  "version": "0.1.0",
  "description": "Adapter penyimpanan IndexedDB untuk @kujam/core",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kustora/kujam.git",
    "directory": "packages/storage-indexeddb"
  },
  "homepage": "https://github.com/kustora/kujam/tree/main/packages/storage-indexeddb#readme",
  "bugs": {
    "url": "https://github.com/kustora/kujam/issues"
  },
  "type": "module",
